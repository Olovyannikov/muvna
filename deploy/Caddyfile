{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Payload: REST API, медиа, админка и её статика
	@cms path /api/* /admin /admin/* /_next/*
	handle @cms {
		reverse_proxy {$CMS_UPSTREAM:cms:3000}
	}

	# Витрина: SSR на Node (ассеты, sitemap.xml, robots.txt — там же)
	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3001}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Редирект со старого/служебного адреса (например, голого IP) на основной.
# По умолчанию — заглушка, которая ни с чем не совпадает.
{$REDIRECT_FROM:http://redirect.invalid} {
	redir {$PUBLIC_URL:https://muvna.ru}{uri} permanent
}

# Dev-стенд (compose-проект muvna-dev в общей сети muvna-edge). Не индексируется поисковиками.
{$DEV_SITE_ADDRESS:http://dev.invalid} {
	encode zstd gzip

	@cms path /api/* /admin /admin/* /_next/*
	handle @cms {
		reverse_proxy dev-cms:3000
	}

	handle {
		reverse_proxy dev-web:3001
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		-Server
	}
}
