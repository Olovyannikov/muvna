# Продакшн-переменные для docker-compose.yml (скопируйте в .env на сервере)

# Публичный адрес сайта (CMS живёт на том же домене: /admin, /api)
PUBLIC_URL=https://muvna.ru
# Домен для Caddy — сертификат выпустится автоматически. Для доступа по IP без HTTPS: SITE_ADDRESS=:80
SITE_ADDRESS=muvna.ru

POSTGRES_USER=muvna
POSTGRES_PASSWORD=change-me
POSTGRES_DB=muvna

# openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Первый администратор (создаёт сид)
SEED_ADMIN_EMAIL=admin@muvna.ru
SEED_ADMIN_PASSWORD=change-me

# Образы из GitHub Container Registry
REGISTRY=ghcr.io/olovyannikov
TAG=latest
