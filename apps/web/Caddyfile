{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Payload: REST API, медиа, админка и её статика
	@cms path /api/* /admin /admin/* /_next/*
	handle @cms {
		reverse_proxy {$CMS_UPSTREAM:cms:3000}
	}

	# Хешированные ассеты Vite кэшируем навсегда
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA: всё остальное — index.html
	handle {
		root * /srv
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Редирект со старого/служебного адреса (например, голого IP) на основной.
# По умолчанию — заглушка, которая ни с чем не совпадает.
{$REDIRECT_FROM:http://redirect.invalid} {
	redir {$PUBLIC_URL:https://muvna.ru}{uri} permanent
}
