# Postgres (docker-compose.dev.yml поднимает его на 5432)
DATABASE_URL=postgres://muvna:muvna@127.0.0.1:5432/muvna
# Любая длинная случайная строка: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Публичный адрес CMS (админка, API, медиа)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Адрес фронтенда — для Live Preview и CORS
WEB_URL=http://localhost:5173
# Первый администратор (создаётся сидом)
SEED_ADMIN_EMAIL=admin@muvna.ru
SEED_ADMIN_PASSWORD=change-me
